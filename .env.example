COMPOSE_PROJECT_NAME=vr-geonusa

API_HOST_PORT=8000
ML_HOST_PORT=8001

# ML service detector. `dummy` needs no artifact; `yolo` loads the artifact at
# ML_MODEL_PATH once at startup and serves it through the same prediction route.
# Serving a model artifact also needs INSTALL_YOLO=true, so the image carries
# Ultralytics and PyTorch. An artifact that is missing or unusable leaves the service
# running and degraded rather than stopping it.
ML_DETECTOR=dummy
ML_MODEL_PATH=/app/artifacts/yolov8n.pt
ML_MODEL_VERSION=yolov8n-coco-v1
ML_IMAGE_SIZE=
ML_CONFIDENCE_THRESHOLD=
INSTALL_YOLO=false

# Artifact the ml-artifacts service fetches into artifacts/, the directory mounted into
# the ML container. Pinned to a release asset and its SHA-256, so every clone fetches
# the same bytes: docker compose --profile artifacts run --rm ml-artifacts
ML_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8n.pt
ML_MODEL_SHA256=f59b3d833e2ff32e194b5bb8e08d211dc7c5bdf144b90d2c8412c47ccfc83b36

POSTGRES_DB=vr_geonusa
POSTGRES_USER=vr_geonusa
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST_PORT=5432

REDIS_HOST_PORT=6379

MINIO_ROOT_USER=replace-with-local-user
MINIO_ROOT_PASSWORD=replace-with-local-password
MINIO_BUCKET=vr-geonusa-dev
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
