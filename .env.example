COMPOSE_PROJECT_NAME=vr-geonusa

API_HOST_PORT=8000
ML_HOST_PORT=8001

# ML service detector. `dummy` needs no artifact; `yolo` loads the artifact at
# ML_MODEL_PATH once at startup and serves it through the same prediction route.
# Serving a model artifact also needs INSTALL_YOLO=true, so the image carries
# Ultralytics and PyTorch.
ML_DETECTOR=dummy
ML_MODEL_PATH=
ML_MODEL_VERSION=
ML_IMAGE_SIZE=
ML_CONFIDENCE_THRESHOLD=
INSTALL_YOLO=false

POSTGRES_DB=vr_geonusa
POSTGRES_USER=vr_geonusa
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST_PORT=5432

REDIS_HOST_PORT=6379

MINIO_ROOT_USER=replace-with-local-user
MINIO_ROOT_PASSWORD=replace-with-local-password
MINIO_BUCKET=vr-geonusa-dev
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
