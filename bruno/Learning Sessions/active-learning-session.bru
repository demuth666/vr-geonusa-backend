meta {
  name: Active learning session
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/me/learning-sessions/active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the active session or null", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("data");
  });
}
