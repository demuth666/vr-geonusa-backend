meta {
  name: List heritage areas
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/heritage-sites/{{heritageSiteSlug}}/areas
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200 && res.body.data[0]?.panorama_nodes[0]) {
    bru.setVar("panoramaNodeId", res.body.data[0].panorama_nodes[0].id);
  }
}

tests {
  test("returns heritage areas", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
  });
}
