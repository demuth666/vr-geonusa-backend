meta {
  name: Start the assessment matching the learning session's current phase
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/learning-sessions/:id/assessment-attempts
  body: json
  auth: bearer
}

params:path {
  id: 
}

headers {
  X-Session-Write-Token: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {}
}

settings {
  forwardAuthorizationHeader: false
}

example {
  name: 201 Response
  description: Assessment attempt created
  
  request: {
    url: {{baseUrl}}/api/v1/learning-sessions/:id/assessment-attempts
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      X-Session-Write-Token: 
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 0,
            "type": "pretest",
            "title": "",
            "status": "draft",
            "submitted_at": "",
            "items": [
              {
                "id": 0,
                "prompt": "",
                "position": 0,
                "selected_option_id": "",
                "options": [
                  {
                    "id": 0,
                    "text": "",
                    "position": 0
                  }
                ]
              }
            ],
            "created_at": "",
            "updated_at": ""
          }
        }
      '''
    }
  }
}

