  request: {
    url: {{baseUrl}}/api/v1/learning-sessions/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      X-Session-Write-Token: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "",
            "message": "",
            "details": {}
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Learning session not found or not owned by the student
  
  request: {
    url: {{baseUrl}}/api/v1/learning-sessions/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      X-Session-Write-Token: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
